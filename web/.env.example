# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real secrets.

# Postgres connection string from the Neon dashboard ("Connect" button)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full

# Better Auth: generate the secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 photo storage (R2 > Manage API tokens)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photoez-cloud-photos

# Claude API (console.anthropic.com > API Keys) for AI features like inquiry triage
ANTHROPIC_API_KEY=
