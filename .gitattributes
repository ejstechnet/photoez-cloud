# Store and check out text files with Linux (LF) line endings,
# since the app runs on a Linux server.
* text=auto eol=lf

# Windows-only scripts keep Windows (CRLF) line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never touch
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
